# KoinMix Miner — environment configuration
#
# Every variable is parsed and validated once, in src/config/env.ts. No other
# module reads process.env: providers reach credentials via Config.secret() and
# non-secret knobs via Config.setting().
#
# Copy to `.env` and adjust. Every value has a working default except
# COINMARKETCAP_API_KEY. NEVER commit a filled-in .env — it is gitignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info                # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=true               # true only for local dev; JSON logs in production

# ── Telegraph miner identity ─────────────────────────────────────────────────
# These mirror `slug` and `id` in telegraph/koinmix.yaml, which is the artifact
# Telegraph nodes actually read. Keep them in sync.
MINER_SLUG=koinmix-crypto-price
MINER_SUBNET_ID=9001

# Floor price per call in USDC. Protocol minimum is 0.01 ($0.01 = 10000 in the
# 6-decimal units `registerMiner()` expects). The on-chain committed value is
# the source of truth; this is mirrored for health output and documentation.
MIN_PRICE_USDC=0.01

# EVM address receiving miner payouts. Required at on-chain registration time,
# not at runtime. Public address only — never a private key.
# MINER_FEE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Price providers ──────────────────────────────────────────────────────────
# Comma-separated provider names to enable. Known names:
#   coingecko, coinmarketcap, binance, coinbase
#
# All four run without credentials, so a fresh checkout serves live prices
# immediately.
PRICE_PROVIDERS=coingecko,coinmarketcap,binance,coinbase

# Per-provider request timeout. One slow provider never stalls a round.
PROVIDER_TIMEOUT_MS=5000

# ── CoinMarketCap ────────────────────────────────────────────────────────────
# OPTIONAL. Without a key the adapter uses CMC's keyless public endpoint, which
# works with no signup but has two limits (both verified against the live API):
#   - USD only. The keyless endpoint silently IGNORES `convert` and returns USD
#     for any currency, so non-USD requests are refused rather than mislabelled.
#   - No per-asset update time, only CMC's response timestamp. Reported as
#     timestampProvenance: "response" rather than "observed".
# Setting a key upgrades to /v2/cryptocurrency/quotes/latest in place, which
# fixes both. Free keys: https://coinmarketcap.com/api/
# COINMARKETCAP_API_KEY=
# COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# ── CoinGecko ────────────────────────────────────────────────────────────────
# Optional. The public tier works keyless; a Demo key raises rate limits.
# Set COINGECKO_API_PLAN=pro only with a paid key — it switches to the Pro host
# and the x-cg-pro-api-key header.
# COINGECKO_API_KEY=
# COINGECKO_API_PLAN=demo        # demo | pro
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ── Binance ──────────────────────────────────────────────────────────────────
# Public market data needs no key. Override the host if api.binance.com is
# geo-restricted where you deploy (it answers HTTP 451) — e.g. api.binance.us.
# NOTE: Binance's global venue has no fiat BTC/USD or ETH/USD spot market, so a
# USD request is served from the USDT pair and flagged with isQuoteProxy.
# BINANCE_BASE_URL=https://api.binance.com

# ── Coinbase ─────────────────────────────────────────────────────────────────
# Public Exchange market data needs no key. Quotes real fiat pairs.
# COINBASE_BASE_URL=https://api.exchange.coinbase.com

# ── Consensus engine ─────────────────────────────────────────────────────────
# Minimum fresh provider quotes required before a price is emitted. Raise to 2+
# in production so no single upstream can move the signal on its own.
CONSENSUS_MIN_SOURCES=1

# Reject the round if any quote deviates from the median by more than this
# (basis points; 200 = 2%). Guards against a bad upstream skewing consensus.
CONSENSUS_MAX_DEVIATION_BPS=200

# Quotes older than this are discarded before consensus (milliseconds).
# CoinGecko's last_updated_at can lag a minute or two on the free tier, so keep
# this generous enough that a legitimately fresh quote is not dropped.
PRICE_MAX_STALENESS_MS=300000

# ── Evidence weighting ───────────────────────────────────────────────────────
# Age at which a quote counts for half as much in the weighted median. Because
# the staleness bound above is deliberately generous, without this a two-minute
# old aggregator print carries exactly as much weight as a one-second old
# exchange print. Live evaluation measured that costing ~2 bps of accuracy and
# roughly doubling the worst round; see "Phase 4" in the README.
# Set to 0 to weigh every surviving quote equally.
PRICE_FRESHNESS_HALFLIFE_MS=10000

# Weight for a quote whose timestamp is the provider's response time rather than
# a real observation time — i.e. one whose true age cannot be checked. Such a
# quote is otherwise credited with perfect freshness on an unverifiable claim.
# 1 disables the penalty, but note that disabling it while leaving the half-life
# above enabled measured WORSE than disabling both: it moves weight from the
# source with an honestly old timestamp onto the source with an unverifiable one.
UNVERIFIED_FRESHNESS_WEIGHT=0.5
