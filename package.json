{
  "name": "koinmix-miner",
  "version": "0.1.0",
  "private": true,
  "description": "KoinMix — a Telegraph Protocol Miner serving the CRYPTO_PRICE intent.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "live:check": "tsx scripts/live-check.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "yaml:hash": "node scripts/yaml-hash.mjs",
    "verify:onchain": "tsx scripts/verify-onchain.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
